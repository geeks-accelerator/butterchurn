# Dependencies
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Build outputs
/dist/
*.min.js.map

# Development tools
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test artifacts
test-fingerprints*.json
test/fingerprints*.json
test/*.mp3
coverage/
.nyc_output/
# jest-image-snapshot writes -diff.png and -received.png here when a visual
# regression test fails. The baseline snapshots in test/visual/__image_snapshots__/*.png
# ARE tracked — only the failure-artifact subdirectories are excluded.
test/visual/__image_snapshots__/__diff_output__/
test/visual/__image_snapshots__/__received_output__/

# Deployment
.netlify

# Environment files
.env
.env.local
.env.*.local

# Preset files - we commit everything for simplicity and consistency
# Only exclude the source JSON files (we have fingerprints for those)
presets/*/butterchurnPresets*.json
presets/*/alaskaButter.json
# But keep all JS files, fingerprints, and metadata
!presets/*/*.fingerprints.json
!presets/*/*.fingerprints.min.json
!presets/*/metadata.json

# Archive and source directories
presets/full-collection/archive/
presets/full-collection/presets/

# Temporary files
*.tmp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Phase 6: CLIP visual style classification artifacts
tools/frames-*/
tools/*visual-styles*.json
tools/test-presets*.json
tools/combined-presets.json
tools/.venv/
# Preset import intermediates
presets/imports/
.venv/
tools/milkdrop-preset-converter/
